# Ghostty Configuration

# Theme
theme = nord

# Font
font-family = HackGen35 Console NF
font-size = 18
adjust-cell-height = 30%

# Window
window-padding-x = 15
window-padding-y = 15

# Behavior
clipboard-read = allow
clipboard-write = allow

# Shell integration
shell-integration = detect

# Quick Terminal (Dropdown Terminal)
quick-terminal-position = top
quick-terminal-size = 99%, 99%
quick-terminal-animation-duration = 0.1
quick-terminal-autohide = true

# macOS Fullscreen (fast, no animation)
macos-non-native-fullscreen = true

# macOS Titlebar (hidden for clean look)
macos-titlebar-style = hidden

# Keybindings
# Let Herdr handle Command+T/W instead of Ghostty's tab/surface actions
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+shift+r=reload_config
keybind = super+d=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
# Open config in nvim via tmux popup
keybind = super+,=text:nvim ~/.config/ghostty/config\x0d
# Toggle quick terminal (global shortcut)
# keybind = global:alt+space=toggle_quick_terminal
